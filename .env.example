# Provider credentials. Never commit the real file.
# Create a free app at https://dashboard.alchemy.com (Ethereum mainnet).
ALCHEMY_API_KEY=your-alchemy-api-key

# Optional: a full provider URL instead of a key (self-hosted proxy, another
# Alchemy-compatible endpoint). Takes precedence over ALCHEMY_API_KEY.
# ALCHEMY_URL=https://eth-mainnet.g.alchemy.com/v2/your-key

# USD valuation of balances. Needs ALCHEMY_API_KEY (the Prices API is a
# different host from the JSON-RPC endpoint, so ALCHEMY_URL alone cannot reach
# it). Set PRICES=off to run without any valuation.
PRICES=on
PRICE_REFRESH_SECONDS=300
# ALCHEMY_PRICES_URL=https://api.g.alchemy.com/prices/v1

# How often to look for new activity, in seconds.
# See the compute-unit budget in README.md before lowering this.
SYNC_INTERVAL_SECONDS=90

# How much history to pull on the very first run.
BACKFILL_DAYS=90

# Blocks re-scanned every cycle so that reorged-out events are corrected.
REORG_DEPTH=64

# Token balances shown per wallet on the dashboard.
MAX_TOKEN_BALANCES=10

# The dashboard warns instead of showing stale data after this many seconds
# without a successful sync. Defaults to 3x SYNC_INTERVAL_SECONDS.
# STALE_AFTER_SECONDS=180

# HTTP basic auth. Set both to require a login; leave either empty and the
# instance is open to anyone who can reach it (and says so in the log).
#
# Basic auth sends the password on every request, reversibly encoded — over
# plain HTTP that is the same as sending it in the clear. Put this behind TLS
# (Caddy) or on a tailnet. It is a lock on the door, not a wall.
AUTH_USER=
AUTH_PASSWORD=

# A token holding worth less than this has to earn its place another way: being
# a token the chain is known for, being listed in trusted_assets, or having been
# sent by one of your own wallets. Never by its raw balance — supplies are
# arbitrary, so "1" of something means nothing.
DUST_BELOW_USD_CENTS=100

# A transfer worth less than this is noise in a log — the 0.000059 USDT that
# arrives beside a real payment. Priced assets only: an unpriced transfer gets
# no verdict either way. 0 shows everything.
DUST_TRANSFER_USD_CENTS=1

# An exchange or long-lived address can hold thousands of airdropped tokens,
# each needing a metadata lookup. This bounds that work.
MAX_TOKEN_LOOKUPS=200

# Timezone used for clock times and the Today/Yesterday day headings.
TZ=UTC

# Host port to publish on, loopback only. Change it if something already uses
# 8000 on the machine.
HOST_PORT=8000

LOG_LEVEL=INFO
